ENCODEMASK="^SECRET_"

SECRET_SINGLE='pa$$word with $HOME'
SECRET_INLINE=value # inline comment
SECRET_INNER=ab"c
export SECRET_EXPORTED="exported secret"
  SECRET_INDENTED = "spaced"
SECRET_MULTI="-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEG==
-----END PRIVATE KEY-----"
PUBLIC_MULTI="line one
line two"
PUBLIC_URL="https://example.com"
