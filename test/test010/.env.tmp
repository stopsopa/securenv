# Mask: only SECRET_ vars are encrypted
ENCODEMASK="^SECRET_"

# regular single-hash comment – must pass through unchanged
SECRET_TOKEN="my_secret_token"
PUBLIC_URL="https://example.com"
SECRET_KEY="my_secret_key"

## simple double-hash comment with content
##no space after hashes
##  two spaces after hashes
##	one tab after hashes
##		two tabs after hashes
##	 tab then space after hashes
## 	space then tab after hashes
  ## leading two spaces before hashes, then content
	## leading one tab before hashes, then content
### triple hash – extra # is part of payload
#### four hashes – extra ## are payload

## line with only spaces after (ignored, must pass through unchanged)
##    
##	
## 
